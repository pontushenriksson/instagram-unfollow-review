{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "2.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "action": { "default_title": "__MSG_name__" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
